# ----------------------------------------------------
# Telegram Bot Configuration
# ----------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here

# (Tùy chọn) Bỏ comment nếu cần proxy kết nối Telegram
# TELEGRAM_PROXY=http://127.0.0.1:10808

# ----------------------------------------------------
# KKPhim Movie API (phimapi.com)
# ----------------------------------------------------
KKPHIM_BASE_URL=https://phimapi.com

# ----------------------------------------------------
# Database & App Settings
# ----------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data.db
LOG_LEVEL=INFO

# ----------------------------------------------------
# Local Telegram Bot API Server (2GB file upload)
# Lấy api_id và api_hash tại https://my.telegram.org
# ----------------------------------------------------
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# (Tùy chọn) Nếu chạy bot trực tiếp trên máy và kết nối vào Local Bot API Server:
# TELEGRAM_API_SERVER=http://127.0.0.1:8081
